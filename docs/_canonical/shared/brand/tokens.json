{
  "$schema": "https://bricks.app/design-system/tokens/v1",
  "name": "Bricks Design System",
  "version": "1.0.0",
  "description": "Unified design tokens for Bricks Scan, Bricks Calc, Bricks Leads (SwiftUI), and Bricks Page (Web).",
  "platforms": ["iOS", "macOS", "web"],

  "color": {
    "comment": "Swift apps use Apple system colors for automatic light/dark mode adaptation. Web uses fixed hex values.",

    "accent": {
      "primary": {
        "swift": "systemBlue",
        "web": "#000000",
        "usage": "Primary interactive color. Buttons, links, active states. Bricks Scan uses systemMint as its per-app accent."
      },
      "secondary": {
        "swift": "systemGreen",
        "web": "#34c85a",
        "usage": "Success states, positive data, secondary actions."
      },
      "tertiary": {
        "swift": "systemOrange",
        "web": null,
        "usage": "Warnings, charts (tertiary series), caution indicators."
      },
      "quaternary": {
        "swift": "systemGray",
        "web": null,
        "usage": "Toolbar buttons, info states, muted UI elements."
      },
      "pro": {
        "swift": "systemPurple",
        "web": null,
        "usage": "Pro/premium features, crown badges, upgrade prompts."
      },
      "teal": {
        "swift": null,
        "web": "#00A6A1",
        "usage": "Web-only accent. The sole brand color used on bricks-page website."
      }
    },

    "background": {
      "primary": {
        "swift-ios": "systemBackground",
        "swift-macos": "windowBackgroundColor",
        "web": "#F6F7F8",
        "usage": "Base background for all views and pages."
      },
      "secondary": {
        "swift-ios": "secondarySystemBackground",
        "swift-macos": "quinaryLabel",
        "web": "#FFFFFF",
        "usage": "Surface cards, sidebars, panels with slight contrast lift."
      },
      "input": {
        "swift": "secondarySystemBackground @ 0.6 opacity",
        "web": null,
        "usage": "Interactive input fields in Swift apps."
      },
      "surfaceShadow": {
        "swift": null,
        "web": "#E7ECEF",
        "usage": "Web shadow anchor for bas-relief/emboss effects."
      },
      "depthPlane": {
        "swift": null,
        "web": "#C9D3DA",
        "usage": "Cool gray for depth definition in web emboss system."
      },
      "edgeDefinition": {
        "swift": null,
        "web": "#9AA7B2",
        "usage": "Edge/border color in web surfaces."
      }
    },

    "text": {
      "primary": {
        "swift-ios": "label",
        "swift-macos": "labelColor",
        "web": "#0B0F14",
        "usage": "Main body text and headings."
      },
      "secondary": {
        "swift-ios": "secondaryLabel",
        "swift-macos": "secondaryLabelColor",
        "web": "#55626E",
        "usage": "Captions, metadata, descriptions, helper text."
      },
      "accent": {
        "swift": "white",
        "web": null,
        "usage": "Text on top of colored/filled backgrounds (e.g. buttons)."
      }
    },

    "semantic": {
      "success": {
        "swift": "systemGreen (accentSecondary)",
        "web": "#34c85a",
        "usage": "Positive feedback, completed states, upload success."
      },
      "warning": {
        "swift": "systemOrange (accentTertiary)",
        "web": null,
        "usage": "Caution states, limit warnings, chart tertiary data."
      },
      "error": {
        "swift": "systemRed",
        "web": null,
        "usage": "Destructive actions, validation errors, failed states."
      },
      "info": {
        "swift": "systemGray (accentQuaternary)",
        "web": null,
        "usage": "Neutral informational states."
      }
    },

    "chart": {
      "primary": { "swift": "systemBlue", "usage": "Primary chart series." },
      "secondary": { "swift": "systemGreen", "usage": "Secondary chart series." },
      "tertiary": { "swift": "systemOrange", "usage": "Tertiary chart series / warning band." }
    },

    "gradient": {
      "accentGradient": {
        "swift": "LinearGradient: black → blue(0.6) → black → black → black, topLeading → bottomTrailing",
        "usage": "Immersive backgrounds for Store, hero sections."
      },
      "appleIntelligenceGradient": {
        "swift": "LinearGradient: blue → purple → pink → red → orange, bottomLeading → topTrailing",
        "usage": "AI feature indicators, Apple Intelligence branding."
      }
    },

    "perApp": {
      "bricksScan": {
        "accentColor": "systemMint",
        "note": "Bricks Scan uniquely uses systemMint as its app accent color."
      },
      "bricksCalc": {
        "accentColor": "systemBlue"
      },
      "bricksLeads": {
        "accentColor": "systemBlue"
      }
    }
  },

  "typography": {
    "fontFamily": {
      "system": {
        "swift": ".system(design: .default)",
        "web": "-apple-system, BlinkMacSystemFont, \"SF Pro Text\", \"SF Pro Display\", system-ui, sans-serif",
        "usage": "Default font for all text across all platforms."
      },
      "rounded": {
        "swift": ".system(design: .rounded)",
        "web": null,
        "usage": "Used for specific UI components like buttons and numeric displays."
      }
    },

    "size": {
      "small":       { "swift": 12, "web": null,  "role": "Fine print, legal, tags" },
      "footnote":    { "swift": 13, "web": null,  "role": "Disclaimers, notes" },
      "caption":     { "swift": 14, "web": 14,    "role": "Metadata, timestamps, labels" },
      "subheadline": { "swift": 15, "web": null,  "role": "Supporting labels, subtitles" },
      "body":        { "swift": 16, "web": 18,    "role": "Main readable content" },
      "headline":    { "swift": 17, "web": null,  "role": "Section labels, list headers" },
      "title3":      { "swift": 20, "web": null,  "role": "Subsection headings" },
      "title2":      { "swift": 24, "web": null,  "role": "Section headings" },
      "title":       { "swift": 28, "web": null,  "role": "Screen/page titles" },
      "largeTitle":  { "swift": 34, "web": null,  "role": "Hero / display text" },
      "heroTitle":   { "swift": null, "web": 56,  "role": "Website hero headline" },
      "sectionTitle":{ "swift": null, "web": 36,  "role": "Website section headings" },
      "subheading":  { "swift": null, "web": 22,  "role": "Website card/feature headings" }
    },

    "weight": {
      "light":    { "swift": ".light",    "web": 300 },
      "regular":  { "swift": ".regular",  "web": 400 },
      "medium":   { "swift": ".medium",   "web": 500 },
      "semibold": { "swift": ".semibold", "web": 600 },
      "bold":     { "swift": ".bold",     "web": 700 },
      "black":    { "swift": null,        "web": 900, "usage": "Web-only: hero and section titles" }
    },

    "lineHeight": {
      "tight":  { "web": 1.05, "usage": "Hero titles" },
      "normal": { "web": 1.5,  "usage": "Default body" },
      "relaxed":{ "web": 1.6,  "usage": "Long-form reading content" }
    },

    "letterSpacing": {
      "tight":   { "web": "-0.03em", "usage": "Hero and section titles" },
      "normal":  { "web": "-0.02em", "usage": "Default headings" },
      "wide":    { "web": "0.05em",  "usage": "Labels, badges, metadata" }
    },

    "textStyle": {
      "comment": "Swift text styles are available as Text extensions (e.g. .titleStyle(), .bodyStyle())",
      "styles": [
        { "name": "titleStyle",                "size": 28, "weight": "bold",     "color": "text.primary" },
        { "name": "title2Style",               "size": 24, "weight": "bold",     "color": "text.primary" },
        { "name": "title3Style",               "size": 20, "weight": "semibold", "color": "text.primary" },
        { "name": "headlineStyle",             "size": 17, "weight": "semibold", "color": "text.primary" },
        { "name": "bodyStyle",                 "size": 16, "weight": "regular",  "color": "text.primary" },
        { "name": "subheadlineStyle",          "size": 15, "weight": "regular",  "color": "text.primary" },
        { "name": "secondarySubheadlineStyle", "size": 15, "weight": "regular",  "color": "text.secondary" },
        { "name": "captionStyle",              "size": 14, "weight": "regular",  "color": "text.primary" },
        { "name": "secondaryCaptionStyle",     "size": 14, "weight": "regular",  "color": "text.secondary" },
        { "name": "footnoteStyle",             "size": 13, "weight": "regular",  "color": "text.primary" },
        { "name": "secondaryFootnoteStyle",    "size": 13, "weight": "regular",  "color": "text.secondary" },
        { "name": "inputLabelStyle",           "size": 14, "weight": "regular",  "color": "text.secondary" }
      ]
    }
  },

  "spacing": {
    "comment": "Swift spacing is in CGFloat (pt). Web spacing is in px.",
    "scale": {
      "none":       { "swift": 0,  "web": null },
      "tiny":       { "swift": 4,  "web": null },
      "small":      { "swift": 8,  "web": null },
      "medium":     { "swift": 16, "web": null },
      "large":      { "swift": 24, "web": null },
      "extraLarge": { "swift": 32, "web": null },
      "spaceSm":    { "swift": null, "web": 32,  "usage": "Web section inner padding" },
      "spaceMd":    { "swift": null, "web": 64,  "usage": "Web section vertical rhythm" },
      "spaceLg":    { "swift": null, "web": 96,  "usage": "Web large section separation" },
      "containerPadding": { "swift": null, "web": 24, "usage": "Web container horizontal gutter" }
    },
    "insets": {
      "listItemPadding":     { "top": 4,  "leading": 0,  "bottom": 4,  "trailing": 0  },
      "sectionHeaderPadding":{ "top": 16, "leading": 16, "bottom": 8,  "trailing": 16 },
      "contentPadding":      { "top": 20, "leading": 20, "bottom": 20, "trailing": 20 }
    }
  },

  "borderRadius": {
    "comment": "Swift: pt values from RoundedRectangle usage. Web: from CSS variables.",
    "icon":    { "swift": 12,  "web": 12,  "usage": "Icon containers, small chips" },
    "small":   { "swift": null, "web": 12, "usage": "Small detail corners (r1-small)" },
    "inner":   { "swift": null, "web": 24, "usage": "Inner cutouts, card inner radius (r2-inner)" },
    "primary": { "swift": null, "web": 48, "usage": "Primary card/panel silhouette (r3-primary)" },
    "default": { "swift": null, "web": 8,  "usage": "General-purpose radius (0.5rem)" }
  },

  "opacity": {
    "subtle": 0.1,
    "light":  0.2,
    "medium": 0.5,
    "high":   0.8
  },

  "shadow": {
    "comment": "Web-only. Swift apps rely on system materials and blur effects.",
    "soft": {
      "value": "0 4px 6px -1px rgba(0,0,0,0.05), 0 2px 4px -1px rgba(0,0,0,0.03)",
      "usage": "Default card resting state."
    },
    "hover": {
      "value": "0 10px 25px -5px rgba(0,0,0,0.1), 0 10px 10px -5px rgba(0,0,0,0.04)",
      "usage": "Card hover / focus lift."
    },
    "embossRaised": {
      "value": "12px 12px 24px #E7ECEF, -12px -12px 24px #FFFFFF",
      "usage": "Bas-relief raised surface (neumorphic)."
    },
    "embossRaisedHover": {
      "value": "16px 16px 32px #E7ECEF, -16px -16px 32px #FFFFFF",
      "usage": "Raised surface on hover."
    },
    "embossRecessed": {
      "value": "inset 6px 6px 12px #E7ECEF, inset -6px -6px 12px #FFFFFF",
      "usage": "Pressed / recessed surface."
    },
    "microSeam": {
      "value": "inset 0 1px 2px #C9D3DA",
      "usage": "Subtle inner top edge seam."
    }
  },

  "animation": {
    "comment": "Web-only easing curves. Swift uses SwiftUI spring/easeInOut system defaults.",
    "easeOutExpo":  { "value": "cubic-bezier(0.16, 1, 0.3, 1)",         "usage": "Panels, drawers, page transitions" },
    "easeSpring":   { "value": "cubic-bezier(0.175, 0.885, 0.32, 1.15)","usage": "Bouncy micro-interactions" },
    "easeReveal":   { "value": "cubic-bezier(0.2, 0.8, 0.2, 1)",        "usage": "Content reveal on scroll" },
    "timing":       { "value": "0.3s ease",                               "usage": "Default transition duration" }
  },

  "layout": {
    "maxWidth":      { "web": 1100, "usage": "Primary content container width" },
    "readingWidth":  { "web": 720,  "usage": "Optimal line-length for long-form text" },
    "grid2Gap":      { "web": 64,   "usage": "Two-column grid gap" },
    "grid3Gap":      { "web": 48,   "usage": "Three-column grid gap" },
    "windowMinWidth":  { "swift-macos": 800,  "usage": "Minimum window width for macOS apps" },
    "windowMinHeight": { "swift-macos": 700,  "usage": "Minimum window height for macOS apps" }
  },

  "iconography": {
    "system": "SF Symbols",
    "comment": "All apps use Apple SF Symbols exclusively. Icons are referenced by symbol name.",
    "coreSymbols": {
      "comment": "Symbols used consistently across 2+ apps — treat as brand vocabulary.",
      "navigation":    ["chevron.left", "chevron.right", "chevron.down", "chevron.up", "arrow.clockwise"],
      "documents":     ["doc.text", "doc.on.doc", "photo", "arrow.up.forward"],
      "actions":       ["plus", "pencil", "trash", "xmark", "checkmark", "square.and.arrow.up"],
      "status":        ["checkmark.circle.fill", "xmark.circle.fill", "exclamationmark.triangle.fill", "info.circle"],
      "user":          ["person.crop.circle", "person.crop.circle.fill"],
      "time":          ["calendar", "clock", "calendar.badge.plus", "calendar.badge.clock"],
      "premium":       ["crown.fill", "star.fill"],
      "settings":      ["gearshape", "gear"],
      "data":          ["chart.pie", "dollarsign.circle", "receipt"]
    },
    "appSpecific": {
      "bricksScan":  ["camera.viewfinder", "doc.text.viewfinder", "crop", "arrow.up.to.line", "arrow.down.to.line", "bell", "bell.badge"],
      "bricksCalc":  ["chart.xyaxis.line", "percent", "building.columns", "receipt.fill", "equal.circle.fill", "hand.draw.fill"],
      "bricksLeads": ["building", "mappin.and.ellipse", "phone", "envelope", "bed.double", "car", "person.badge.plus", "location", "map"]
    }
  }
}
